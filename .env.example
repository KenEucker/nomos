# ================================
# Core / Runtime
# ================================
NODE_ENV=
# Optional. Runtime environment: development | test | production.
# Default: development when unset.

BUILD_SHA=
# Optional. Build identifier returned by GET /version.
# Default: "dev" when unset.

# ================================
# Server / Networking
# ================================
PORT=
# Optional. Port the Fastify server listens on.
# Default: 3001 when unset.

# ================================
# Database
# ================================
DATABASE_URL=
# Optional. Database connection string.
# Default: "file:./prisma/dev.db" when unset.
# Example: file:./prisma/dev.db

# ================================
# Authentication
# ================================
JWT_SECRET=
# Required for signed JWT verification. Security-sensitive.
# Default: "dev-secret" in code (development-only default; set explicitly in prod).

DEV_AUTH_SECRET=
# Optional. Development-only shared secret (not used by V1 demo).

# ================================
# Swagger / Docs
# ================================
SWAGGER_PUBLIC=
# Optional. Controls public access to /openapi.json and /docs.
# In production: default false; must be "true" to allow public access.
# In development: default true when unset.

# ================================
# Logging / Observability
# ================================
LOG_LEVEL=
# Optional. Logging level (e.g., info, debug).
# Default: "info" when unset.

LOG_PRETTY=
# Optional. Pretty-print logs ("true" | "false").
# Default: true in development, false in production.

LOG_ERROR_STACK=
# Optional. Include error stack traces in responses/logs ("true" | "false").
# Default: true in development, false in production.

LOG_DOMAINS=
# Optional. Comma-separated list of log domains to enable.
# Default: all domains enabled when unset.

DIAGNOSTICS_ENABLED=
# Optional. Enables admin diagnostics endpoints.
# Default: true in development, false in production.
