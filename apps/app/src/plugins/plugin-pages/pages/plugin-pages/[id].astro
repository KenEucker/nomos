---
import AdminLayout from "../../../../admin-ui/src/layouts/AdminLayout.astro";

const { id } = Astro.params;
---

<AdminLayout title={`Plugin Page ${id}`}>
  <div class="p-6">
    <h1 class="text-2xl font-semibold text-slate-900">Plugin Page {id}</h1>
    <p class="mt-2 text-sm text-slate-600">
      This dynamic route is injected from the plugin-pages fixture.
    </p>
  </div>
</AdminLayout>
