---
import ResourcePanelPage from "../../../../../admin-ui/src/components/ResourcePanelPage.astro";
import { createResourcePanel, type ResourcePanelConfig } from "../../../../../admin-ui/src/lib/resource-panel";
import { usersResource } from "../users.resource";

const { id } = Astro.params;
const resourceConfig: ResourcePanelConfig = {
  resource: usersResource,
  mode: "view",
  params: { id },
};
const panel = createResourcePanel(resourceConfig);
---
<ResourcePanelPage {panel} resourceConfig={resourceConfig} />
