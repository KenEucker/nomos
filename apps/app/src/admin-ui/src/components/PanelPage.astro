---
import "../styles/global.css"
import { Toaster } from "$ui/sonner"
import PanelRuntime from "../islands/PanelRuntime.svelte"
import { buildPanelCtx } from "../lib/state"
import type { PanelModule } from "../lib/types"
import AdminLayout from "../layouts/AdminLayout.astro"
import ErrorDisplay from "./ErrorDisplay.astro"
import { ServerApiError } from "../lib/server/api"

const { panel, panelModuleKey } = Astro.props as {
  panel: PanelModule
  panelModuleKey: string
}

const ctx = buildPanelCtx(Astro.url, {}, Astro.request)
const authPayload = Astro.locals.auth ?? { subject: null, capabilities: {} }

// Try to fetch data, catch errors gracefully
let data: Record<string, unknown> | null = null
let error: { message: string; code?: string; status?: number } | null = null

try {
  const result = await panel.query(ctx)
  if (!result || typeof result !== "object" || Array.isArray(result)) {
    throw new Error("Panel query must return a keyed data bag")
  }
  data = result as Record<string, unknown>
} catch (e) {
  if (e instanceof ServerApiError) {
    error = {
      message: e.message,
      code: e.code,
      status: e.status,
    }
  } else if (e instanceof Error) {
    error = { message: e.message }
  } else {
    error = { message: "An unknown error occurred" }
  }
}

---

{error ? (
  <AdminLayout title="Error">
    <ErrorDisplay
      title={error.status === 403 ? "Access Denied" : "Error"}
      message={error.message}
      code={error.code}
      status={error.status}
    />
  </AdminLayout>
) : data ? (
  <>
    <AdminLayout subject={authPayload.subject}>
      <div class="space-y-6">
        <PanelRuntime
          panelModuleKey={panelModuleKey}
          initialData={data}
          initialNodes={panel.layout(data, ctx)}
          initialCommands={panel.commandBar(ctx, data)}
          href={Astro.url.toString()}
          client:load
        />
      </div>
      <Toaster client:load />
    </AdminLayout>
  </>
) : null}
