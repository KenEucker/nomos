---
import AdminLayout from "../../layouts/AdminLayout.astro";
import DiagnosticsView from "./DiagnosticsView.svelte";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "diagnostics",
  title: "Diagnostics",
  subtitle: "Inspect runtime health and system status.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <DiagnosticsView client:load />
</AdminLayout>
