---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ResourceView from "../../islands/ResourceView.svelte";
import { createStaticListModule } from "../../lib/pages";
import { diagnosticsResource } from "./diagnostics.resource";

export const staticPageDefinition = createStaticListModule({
  resourceId: "diagnostics",
  title: "Diagnostics",
  subtitle: "Inspect runtime health and system status.",
});
---
<AdminLayout
  title={staticPageDefinition.title}
  subtitle={staticPageDefinition.subtitle}
  breadcrumbs={staticPageDefinition.breadcrumbs}
  actions={staticPageDefinition.pageActions}
>
  <ResourceView client:load definition={diagnosticsResource} view="List" />
</AdminLayout>
