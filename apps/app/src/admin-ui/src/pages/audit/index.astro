---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "audit",
  title: "Audit Log",
  subtitle: "Review recent admin events and actions.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <div id="audit-root" class="space-y-4"></div>
</AdminLayout>

<script type="module">
  import { apiGet } from "../../lib/api";
  import { session, hasRole } from "../../lib/session";

  const root = document.getElementById("audit-root");

  const state = {
    loading: true,
    audit: [],
    search: "",
    eventFilter: "",
    expandedRow: null,
  };

  const formatDate = (date) =>
    new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" }).format(new Date(date));

  const render = () => {
    if (!root) return;
    if (state.loading) {
      root.innerHTML = `
        <div class="flex items-center justify-center py-12 text-slate-400">
          <div class="flex flex-col items-center gap-2">
            <div class="w-6 h-6 border-2 rounded-full animate-spin border-slate-600 border-t-slate-200"></div>
            <span>Loading audit log...</span>
          </div>
        </div>
      `;
      return;
    }
    const uniqueEvents = [...new Set(state.audit.map((entry) => entry.event))].sort();
    const filtered = state.audit
      .filter((entry) => {
        if (state.eventFilter && entry.event !== state.eventFilter) return false;
        if (state.search) {
          const searchLower = state.search.toLowerCase();
          return (
            entry.event.toLowerCase().includes(searchLower) ||
            entry.userId?.toLowerCase().includes(searchLower) ||
            entry.resource?.toLowerCase().includes(searchLower) ||
            entry.action?.toLowerCase().includes(searchLower)
          );
        }
        return true;
      })
      .reverse();

    const rows = filtered
      .map((entry, index) => {
        const detailRow = state.expandedRow === index && entry.details
          ? `
            <tr class="border-t border-slate-800 bg-slate-900/50">
              <td colspan="6" class="px-4 py-3">
                <pre class="overflow-auto text-xs text-slate-400 max-h-48">${JSON.stringify(entry.details, null, 2)}</pre>
              </td>
            </tr>
          `
          : "";
        return `
          <tr class="border-t border-slate-800 hover:bg-slate-800/30">
            <td class="px-4 py-3 text-xs text-slate-400 whitespace-nowrap">${formatDate(entry.timestamp)}</td>
            <td class="px-4 py-3"><span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${entry.event}</span></td>
            <td class="hidden px-4 py-3 font-mono text-xs text-slate-400 md:table-cell">
              ${entry.userId ? `${entry.userId.slice(0, 8)}...` : entry.apiKeyId ? `${entry.apiKeyId.slice(0, 8)}...` : "-"}
            </td>
            <td class="hidden px-4 py-3 text-slate-400 lg:table-cell">${entry.resource ?? "-"}</td>
            <td class="hidden px-4 py-3 text-slate-400 lg:table-cell">${entry.action ?? "-"}</td>
            <td class="px-4 py-3">
              ${entry.details ? `<button data-action="toggle" data-index="${index}" class="text-xs text-slate-300 hover:text-slate-100">${state.expandedRow === index ? "Hide" : "Details"}</button>` : ""}
            </td>
          </tr>
          ${detailRow}
        `;
      })
      .join("");

    root.innerHTML = `
      <div class="flex flex-col gap-3 mb-4 sm:flex-row sm:items-center sm:flex-wrap">
        <div class="flex flex-1 gap-2">
          <input id="audit-search" class="flex-1 sm:max-w-xs rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" placeholder="Search..." value="${state.search}" />
          <select id="audit-filter" class="min-w-0 px-3 py-2 text-sm border rounded bg-slate-900 border-slate-700 text-slate-100">
            <option value="">All events</option>
            ${uniqueEvents.map((event) => `<option value="${event}" ${event === state.eventFilter ? "selected" : ""}>${event}</option>`).join("")}
          </select>
        </div>
        <div class="flex gap-2">
          <button id="audit-refresh" class="flex-1 sm:flex-none rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Refresh</button>
          <button id="audit-export" class="flex-1 sm:flex-none rounded bg-slate-200 px-3 py-2 text-sm text-slate-900">Export</button>
        </div>
      </div>
      ${filtered.length === 0
        ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No audit entries found.</div>'
        : `
          <div class="mb-2 text-xs text-slate-500">Showing ${filtered.length} entries</div>
          <div class="hidden border rounded-lg border-slate-800 bg-slate-900/40 sm:block">
            <table class="w-full">
              <thead class="text-xs text-left uppercase text-slate-400">
                <tr>
                  <th class="px-4 py-3">Timestamp</th>
                  <th class="px-4 py-3">Event</th>
                  <th class="hidden px-4 py-3 md:table-cell">User / Key</th>
                  <th class="hidden px-4 py-3 lg:table-cell">Resource</th>
                  <th class="hidden px-4 py-3 lg:table-cell">Action</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody class="text-sm">${rows}</tbody>
            </table>
          </div>
        `
      }
    `;

    document.getElementById("audit-search")?.addEventListener("input", (event) => {
      state.search = event.target.value;
      render();
    });
    document.getElementById("audit-filter")?.addEventListener("change", (event) => {
      state.eventFilter = event.target.value;
      render();
    });
    document.getElementById("audit-refresh")?.addEventListener("click", loadAudit);
    document.getElementById("audit-export")?.addEventListener("click", exportToCsv);
    root.querySelectorAll("[data-action='toggle']").forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(button.getAttribute("data-index"));
        state.expandedRow = state.expandedRow === index ? null : index;
        render();
      });
    });
  };

  const exportToCsv = () => {
    const headers = ["Timestamp", "Event", "User ID", "API Key ID", "Resource", "Action", "IP"];
    const rows = state.audit.map((entry) => [
      entry.timestamp,
      entry.event,
      entry.userId ?? "",
      entry.apiKeyId ?? "",
      entry.resource ?? "",
      entry.action ?? "",
      entry.ip ?? ""
    ]);
    const csv = [headers.join(","), ...rows.map((row) => row.join(","))].join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `audit-log-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const loadAudit = async () => {
    state.loading = true;
    render();
    try {
      const response = await apiGet("/_/audit");
      state.audit = response.data?.audit ?? [];
    } catch (e) {
      console.error("Failed to load audit log", e);
      state.audit = [];
    }
    state.loading = false;
    render();
  };

  const unsubscribe = session.subscribe((value) => {
    if (!value) return;
    unsubscribe();
    if (!hasRole(value, "admin")) {
      window.location.href = "/";
      return;
    }
    loadAudit();
  });

  render();
</script>
