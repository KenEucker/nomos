---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdminSession } from "../../lib/server/session";
import { serverApiFetch } from "../../lib/server/api";

const sessionResult = await requireAdminSession(Astro);
if (sessionResult instanceof Response) {
  return sessionResult;
}

if (Astro.request.method === "POST") {
  await serverApiFetch(Astro.request, "/audit/clear", { method: "POST" });
  return Astro.redirect("/audit");
}
---
<BaseLayout title="Clear Audit Log">
  <div class="min-h-screen bg-background text-foreground">
    <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-4 py-8 sm:px-6">
      <div class="rounded-xl border border-border bg-card/40 p-6 shadow-xl sm:p-8">
        <h1 class="text-xl font-semibold sm:text-2xl">Clear audit log?</h1>
        <p class="mt-2 text-sm text-muted-foreground">
          This will permanently delete all audit log entries.
        </p>
        <form method="post" class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <a
            href="/audit"
            class="inline-flex items-center justify-center rounded-md border border-border px-4 py-2 text-sm text-foreground hover:bg-accent"
          >
            Cancel
          </a>
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-md bg-destructive px-4 py-2 text-sm text-white hover:bg-destructive/90"
          >
            Clear log
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
