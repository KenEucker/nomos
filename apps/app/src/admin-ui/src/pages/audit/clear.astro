---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireAdminSession } from "../../lib/server/session";
import { serverApiFetch } from "../../lib/server/api";

const sessionResult = await requireAdminSession(Astro);
if (sessionResult instanceof Response) {
  return sessionResult;
}

if (Astro.request.method === "POST") {
  await serverApiFetch(Astro.request, "/_/audit/clear", { method: "POST" });
  return Astro.redirect("/admin/audit");
}
---
<BaseLayout title="Clear Audit Log">
  <div class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-4 py-8 sm:px-6">
      <div class="rounded-xl border border-slate-200 bg-white/40 p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900/40 sm:p-8">
        <h1 class="text-xl font-semibold sm:text-2xl">Clear audit log?</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          This will permanently delete all audit log entries.
        </p>
        <form method="post" class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <a
            href="/admin/audit"
            class="inline-flex items-center justify-center rounded-md border border-slate-300 px-4 py-2 text-sm text-slate-900 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-100 dark:hover:bg-slate-900"
          >
            Cancel
          </a>
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-md bg-red-500 px-4 py-2 text-sm text-white hover:bg-red-600"
          >
            Clear log
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
