---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ResourceView from "../../islands/ResourceView.svelte";
import { createStaticPageDefinition } from "../../lib/pages";
import { routesResource } from "./routes.resource";

export const staticPageDefinition = createStaticPageDefinition({
  resourceId: "routes",
  title: "Routes",
  subtitle: "Inspect registered route handlers and metadata.",
});
---
<AdminLayout title={staticPageDefinition.title} subtitle={staticPageDefinition.subtitle} breadcrumbs={staticPageDefinition.breadcrumbs} actions={staticPageDefinition.pageActions}>
  <ResourceView client:load definition={routesResource} view="List" />
</AdminLayout>
