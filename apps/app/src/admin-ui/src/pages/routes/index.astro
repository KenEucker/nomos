---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "routes",
  title: "Routes",
  subtitle: "Inspect registered route handlers and metadata.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <div id="routes-root" class="space-y-4"></div>
</AdminLayout>

<script type="module">
  import { apiGet } from "../../lib/api";
  import { session, hasRole } from "../../lib/session";

  const root = document.getElementById("routes-root");
  const state = { loading: true, routes: [], search: "", methodFilter: "", ownerFilter: "" };

  const getMethodColor = (method) => {
    switch (method.toUpperCase()) {
      case "GET": return "bg-green-600";
      case "POST": return "bg-blue-600";
      case "PUT": return "bg-yellow-600";
      case "PATCH": return "bg-orange-600";
      case "DELETE": return "bg-red-600";
      default: return "bg-slate-600";
    }
  };

  const render = () => {
    if (!root) return;
    if (state.loading) {
      root.innerHTML = '<div class="text-slate-400">Loading routes...</div>';
      return;
    }
    const uniqueMethods = [...new Set(state.routes.map((r) => r.method.toUpperCase()))].sort();
    const uniqueOwners = [...new Set(state.routes.map((r) => r.owner ?? "core"))].sort();
    const filtered = state.routes.filter((route) => {
      if (state.methodFilter && route.method.toUpperCase() !== state.methodFilter) return false;
      if (state.ownerFilter && (route.owner ?? "core") !== state.ownerFilter) return false;
      if (state.search) {
        const searchLower = state.search.toLowerCase();
        return (
          route.path.toLowerCase().includes(searchLower) ||
          route.id.toLowerCase().includes(searchLower) ||
          route.config.summary?.toLowerCase().includes(searchLower)
        );
      }
      return true;
    });
    const grouped = filtered.reduce((acc, route) => {
      const owner = route.owner ?? "core";
      acc[owner] = acc[owner] ?? [];
      acc[owner].push(route);
      return acc;
    }, {});

    const groups = Object.entries(grouped).map(([owner, ownerRoutes]) => `
      <div class="space-y-2">
        <div class="text-xs uppercase text-slate-500">${owner}</div>
        <div class="border rounded-lg border-slate-800 bg-slate-900/40">
          <table class="w-full">
            <thead class="text-xs text-left uppercase text-slate-400">
              <tr>
                <th class="px-4 py-3">Method</th>
                <th class="px-4 py-3">Path</th>
                <th class="hidden px-4 py-3 md:table-cell">Summary</th>
                <th class="px-4 py-3">Auth</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              ${ownerRoutes.map((route) => `
                <tr class="border-t border-slate-800">
                  <td class="px-4 py-3">
                    <span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">
                      <span class="inline-block h-2 w-2 rounded-full mr-2 ${getMethodColor(route.method)}"></span>
                      ${route.method.toUpperCase()}
                    </span>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-slate-100">${route.path}</td>
                  <td class="hidden px-4 py-3 text-slate-400 md:table-cell">${route.config.summary ?? "—"}</td>
                  <td class="px-4 py-3 text-xs text-slate-400">${route.config.auth ?? "public"}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      </div>
    `).join("");

    root.innerHTML = `
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <input id="routes-search" class="max-w-sm rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" placeholder="Search routes..." value="${state.search}" />
        <select id="routes-method" class="px-3 py-2 text-sm border rounded bg-slate-900 border-slate-700 text-slate-100">
          <option value="">All methods</option>
          ${uniqueMethods.map((method) => `<option value="${method}" ${method === state.methodFilter ? "selected" : ""}>${method}</option>`).join("")}
        </select>
        <select id="routes-owner" class="px-3 py-2 text-sm border rounded bg-slate-900 border-slate-700 text-slate-100">
          <option value="">All owners</option>
          ${uniqueOwners.map((owner) => `<option value="${owner}" ${owner === state.ownerFilter ? "selected" : ""}>${owner}</option>`).join("")}
        </select>
        <button id="routes-refresh" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Refresh</button>
      </div>
      ${filtered.length === 0
        ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No routes found.</div>'
        : groups
      }
    `;

    document.getElementById("routes-search")?.addEventListener("input", (event) => {
      state.search = event.target.value;
      render();
    });
    document.getElementById("routes-method")?.addEventListener("change", (event) => {
      state.methodFilter = event.target.value;
      render();
    });
    document.getElementById("routes-owner")?.addEventListener("change", (event) => {
      state.ownerFilter = event.target.value;
      render();
    });
    document.getElementById("routes-refresh")?.addEventListener("click", loadRoutes);
  };

  const loadRoutes = async () => {
    state.loading = true;
    render();
    try {
      const response = await apiGet("/_/routes");
      state.routes = response.data?.routes ?? [];
    } catch (e) {
      console.error("Failed to load routes", e);
      state.routes = [];
    }
    state.loading = false;
    render();
  };

  const unsubscribe = session.subscribe((value) => {
    if (!value) return;
    unsubscribe();
    if (!hasRole(value, "admin")) {
      window.location.href = "/";
      return;
    }
    loadRoutes();
  });

  render();
</script>
