---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ResourceListCard from "../../components/admin/ResourceListCard.astro";
import Badge from "../../components/ui/badge.svelte";
import Button from "../../components/ui/button.svelte";
import Table from "../../components/ui/table.svelte";
import { serverApiGet } from "../../lib/server/api";
import type { SessionUser } from "../../lib/session";

type RoleRow = {
  id: string;
  key: string;
  name: string;
  userCount: number;
};

const search = Astro.url.searchParams.get("search") ?? "";
const page = Number(Astro.url.searchParams.get("page") ?? "1");
const pageSize = Number(Astro.url.searchParams.get("pageSize") ?? "20");
const query = new URLSearchParams({
  page: String(page),
  pageSize: String(pageSize)
});

if (search) {
  query.set("search", search);
}

let user: SessionUser | null = null;
let roles: RoleRow[] = [];
let total = 0;
let errorMessage = "";

try {
  const sessionResponse = await serverApiGet<{ user: SessionUser }>(Astro, "/auth/me");
  user = sessionResponse.data?.user ?? null;
} catch (err) {
  if (err instanceof Response) {
    return err;
  }
  throw err;
}

try {
  const response = await serverApiGet<{ roles: RoleRow[] }>(Astro, `/roles?${query.toString()}`);
  roles = response.data?.roles ?? [];
  total = response.meta?.total ?? roles.length;
} catch (err) {
  if (err instanceof Response) {
    return err;
  }
  if ((err as Error).message === "forbidden") {
    errorMessage = "You do not have access to view roles.";
  } else {
    throw err;
  }
}
---

<AdminLayout title="Roles" user={user}>
  {errorMessage ? (
    <div class="p-4 text-red-700 border border-red-200 rounded-lg bg-red-50 dark:border-red-800 dark:bg-red-900/20 dark:text-red-200">
      <strong>Error:</strong> {errorMessage}
    </div>
  ) : (
    <ResourceListCard
      searchValue={search}
      searchPlaceholder="Search roles..."
      createHref="/admin/roles/new"
      createLabel="New role"
      total={total}
      page={page}
      pageSize={pageSize}
    >
      <div class="border rounded-lg border-slate-200 bg-white/40 dark:border-slate-800 dark:bg-slate-900/40">
        <Table>
          <thead class="text-xs text-left uppercase text-slate-500 dark:text-slate-400">
            <tr>
              <th class="px-4 py-3">Key</th>
              <th class="px-4 py-3">Name</th>
              <th class="px-4 py-3">Users</th>
              <th class="px-4 py-3">Actions</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            {roles.length ? (
              roles.map((entry) => (
                <tr class="border-t border-slate-200 hover:bg-slate-100/50 dark:border-slate-800 dark:hover:bg-slate-800/30">
                  <td class="px-4 py-3 font-medium text-slate-900 dark:text-slate-100">{entry.key}</td>
                  <td class="px-4 py-3">{entry.name}</td>
                  <td class="px-4 py-3">
                    <Badge variant="secondary">{entry.userCount}</Badge>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex gap-2">
                      <form method="get" action={`/admin/roles/${entry.id}`}>
                        <Button type="submit" variant="ghost" size="sm">View</Button>
                      </form>
                      <form method="get" action={`/admin/roles/${entry.id}/edit`}>
                        <Button type="submit" variant="ghost" size="sm">Edit</Button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td class="px-4 py-6 text-center text-slate-500 dark:text-slate-400" colSpan={4}>
                  No roles found.
                </td>
              </tr>
            )}
          </tbody>
        </Table>
      </div>
    </ResourceListCard>
  )}
</AdminLayout>
