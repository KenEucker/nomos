---
import Shell from "../../components/Shell.astro";
import ResourceList from "../../islands/ResourceList.svelte";
import ResourceForm from "../../islands/ResourceForm.svelte";
const manifest = await fetch("/admin/manifest").then((res) => res.json()).catch(() => ({ resources: [] }));
const path = Astro.params.path ?? "";
const resource = manifest.resources?.find((item) => item.route.replace("/admin/", "") === path);
const data = resource ? await fetch(resource.route).then((res) => res.json()).catch(() => ({})) : {};
export const prerender = false;
---
<Shell title={resource?.label ?? "Admin"}>
  <div class="layout">
    <aside class="sidebar">
      <h2>Admin</h2>
      <nav>
        {manifest.nav?.map((item) => (
          <a href={item.path}>{item.label}</a>
        ))}
      </nav>
    </aside>
    <main class="content">
      <h1>{resource?.label ?? "Admin"}</h1>
      {resource ? (
        <>
          <ResourceList client:load resources={[resource]} data={data} />
          <ResourceForm client:load resource={resource} />
        </>
      ) : (
        <p>Resource not found.</p>
      )}
    </main>
  </div>
</Shell>
