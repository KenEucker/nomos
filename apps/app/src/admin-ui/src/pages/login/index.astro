---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginForm from "../../islands/LoginForm.svelte";
import { requireAdminSession } from "../../lib/server/session";


const sessionResult = await requireAdminSession(Astro);
if (sessionResult instanceof Response) {}
else {
  return Astro.redirect("/admin");
}
---
<BaseLayout title="Admin Login">
  <div class="min-h-screen bg-background text-foreground">
    <div class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-8 sm:px-6">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold sm:text-3xl">Nomos Admin</h1>
      </div>
      <div class="rounded-xl border border-border bg-card/40 p-6 shadow-xl sm:p-8">
        <h2 class="text-xl font-semibold sm:text-2xl">Sign in</h2>
        <p class="mb-6 text-sm text-muted-foreground">Use your credentials to access the admin UI.</p>
        <LoginForm client:load />
      </div>
    </div>
  </div>
</BaseLayout>
