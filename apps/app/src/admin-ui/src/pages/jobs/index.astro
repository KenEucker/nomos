---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "jobs",
  title: "Jobs",
  subtitle: "Monitor scheduled work and job runs.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <div id="jobs-root" class="space-y-4"></div>
</AdminLayout>

<script type="module">
  import { apiGet, apiPost } from "../../lib/api";
  import { session, hasRole } from "../../lib/session";

  const root = document.getElementById("jobs-root");
  const state = {
    loading: true,
    jobs: [],
    runs: [],
    activeTab: "jobs",
    autoRefresh: false,
    refreshInterval: null,
    showTrigger: false,
    selectedJobId: "",
    triggerPayload: "{}",
  };

  const formatDate = (date) => {
    if (!date) return "-";
    return new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" }).format(new Date(date));
  };

  const getDuration = (run) => {
    if (!run.startedAt) return "-";
    const start = new Date(run.startedAt).getTime();
    const end = run.completedAt ? new Date(run.completedAt).getTime() : Date.now();
    const ms = end - start;
    if (ms < 1000) return `${ms}ms`;
    return `${(ms / 1000).toFixed(1)}s`;
  };

  const render = () => {
    if (!root) return;
    if (state.loading) {
      root.innerHTML = `
        <div class="flex items-center justify-center py-12 text-slate-400">
          <div class="flex flex-col items-center gap-2">
            <div class="w-6 h-6 border-2 rounded-full animate-spin border-slate-600 border-t-slate-200"></div>
            <span>Loading jobs...</span>
          </div>
        </div>
      `;
      return;
    }
    const jobsTable = state.jobs.length === 0
      ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No jobs registered.</div>'
      : `
        <div class="hidden border rounded-lg border-slate-800 bg-slate-900/40 sm:block">
          <table class="w-full">
            <thead class="text-xs text-left uppercase text-slate-400">
              <tr>
                <th class="px-4 py-3">Job ID</th>
                <th class="px-4 py-3">Queue</th>
                <th class="hidden px-4 py-3 md:table-cell">Concurrency</th>
                <th class="hidden px-4 py-3 md:table-cell">Retries</th>
                <th class="hidden px-4 py-3 lg:table-cell">Schedule</th>
                <th class="px-4 py-3">Actions</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              ${state.jobs.map((job) => `
                <tr class="border-t border-slate-800 hover:bg-slate-800/30">
                  <td class="px-4 py-3 font-mono text-slate-100">${job.id}</td>
                  <td class="px-4 py-3 text-slate-400">${job.queue ?? "default"}</td>
                  <td class="hidden px-4 py-3 text-slate-400 md:table-cell">${job.concurrency ?? 1}</td>
                  <td class="hidden px-4 py-3 text-slate-400 md:table-cell">${job.retries ?? 0}</td>
                  <td class="hidden px-4 py-3 text-xs font-mono text-slate-400 lg:table-cell">${job.schedule ?? "-"}</td>
                  <td class="px-4 py-3">
                    <button data-trigger="${job.id}" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Trigger</button>
                  </td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        </div>
      `;

    const runsTable = state.runs.length === 0
      ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No job runs yet.</div>'
      : `
        <table class="w-full">
          <thead class="text-xs text-left uppercase text-slate-400">
            <tr>
              <th class="pb-2">Job ID</th>
              <th class="pb-2">Status</th>
              <th class="pb-2">Started</th>
              <th class="pb-2">Duration</th>
              <th class="pb-2">Actions</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            ${state.runs.slice(-50).reverse().map((run) => `
              <tr class="border-t border-slate-800">
                <td class="py-3 font-mono text-xs text-slate-400">${run.jobId}</td>
                <td class="py-3"><span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${run.status}</span></td>
                <td class="py-3 text-xs text-slate-400">${formatDate(run.startedAt)}</td>
                <td class="py-3 text-xs text-slate-400">${getDuration(run)}</td>
                <td class="py-3">
                  ${run.status === "failed" ? `<button data-retry="${run.jobId}" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Retry</button>` : ""}
                </td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      `;

    root.innerHTML = `
      <div class="flex flex-col gap-3 mb-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex gap-2">
          <button data-tab="jobs" class="rounded px-3 py-2 text-sm ${state.activeTab === "jobs" ? "bg-slate-200 text-slate-900" : "border border-slate-700 text-slate-200"}">Jobs</button>
          <button data-tab="runs" class="rounded px-3 py-2 text-sm ${state.activeTab === "runs" ? "bg-slate-200 text-slate-900" : "border border-slate-700 text-slate-200"}">Runs</button>
        </div>
        <div class="flex items-center gap-2">
          <button id="jobs-auto" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">${state.autoRefresh ? "Auto ON" : "Auto OFF"}</button>
          <button id="jobs-refresh" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Refresh</button>
        </div>
      </div>
      ${state.activeTab === "jobs" ? jobsTable : runsTable}
      ${state.showTrigger ? `
        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
          <h2 class="text-lg font-semibold">Trigger Job</h2>
          <div class="space-y-3 mt-4">
            <div>
              <label class="block mb-1 text-sm text-slate-400">Job ID</label>
              <div class="p-2 font-mono text-sm truncate border rounded bg-slate-900 border-slate-700">${state.selectedJobId}</div>
            </div>
            <div>
              <label class="block mb-1 text-sm text-slate-400">Payload (JSON)</label>
              <textarea id="job-payload" class="w-full h-32 p-2 font-mono text-sm border rounded resize-none bg-slate-900 border-slate-700 text-slate-100">${state.triggerPayload}</textarea>
            </div>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <button id="job-cancel" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Cancel</button>
            <button id="job-trigger" class="rounded bg-slate-200 px-3 py-2 text-sm text-slate-900">Trigger</button>
          </div>
        </div>
      ` : ""}
    `;

    root.querySelectorAll("[data-tab]").forEach((button) => {
      button.addEventListener("click", () => {
        state.activeTab = button.getAttribute("data-tab");
        render();
      });
    });
    document.getElementById("jobs-auto")?.addEventListener("click", toggleAutoRefresh);
    document.getElementById("jobs-refresh")?.addEventListener("click", loadJobs);
    root.querySelectorAll("[data-trigger]").forEach((button) => {
      button.addEventListener("click", () => {
        state.selectedJobId = button.getAttribute("data-trigger");
        state.triggerPayload = "{}";
        state.showTrigger = true;
        render();
      });
    });
    root.querySelectorAll("[data-retry]").forEach((button) => {
      button.addEventListener("click", () => retryJob(button.getAttribute("data-retry")));
    });
    document.getElementById("job-cancel")?.addEventListener("click", () => {
      state.showTrigger = false;
      render();
    });
    document.getElementById("job-trigger")?.addEventListener("click", () => triggerJob());
    document.getElementById("job-payload")?.addEventListener("input", (event) => {
      state.triggerPayload = event.target.value;
    });
  };

  const loadJobs = async () => {
    state.loading = true;
    render();
    try {
      const response = await apiGet("/_/jobs");
      state.jobs = response.data?.jobs ?? [];
      state.runs = response.data?.runs ?? [];
    } catch (e) {
      console.error("Failed to load jobs", e);
      state.jobs = [];
      state.runs = [];
    }
    state.loading = false;
    render();
  };

  const triggerJob = async () => {
    try {
      let payload = {};
      try {
        payload = JSON.parse(state.triggerPayload);
      } catch {
        payload = {};
      }
      await apiPost("/_/jobs", { jobId: state.selectedJobId, payload });
      state.showTrigger = false;
      state.triggerPayload = "{}";
      await loadJobs();
    } catch (e) {
      console.error("Failed to trigger job", e);
    }
  };

  const retryJob = async (jobId) => {
    try {
      const run = state.runs.find((entry) => entry.jobId === jobId);
      await apiPost("/_/jobs", { jobId, payload: run?.payload });
      await loadJobs();
    } catch (e) {
      console.error("Failed to retry job", e);
    }
  };

  const toggleAutoRefresh = () => {
    state.autoRefresh = !state.autoRefresh;
    if (state.autoRefresh) {
      state.refreshInterval = setInterval(loadJobs, 5000);
    } else if (state.refreshInterval) {
      clearInterval(state.refreshInterval);
      state.refreshInterval = null;
    }
    render();
  };

  const unsubscribe = session.subscribe((value) => {
    if (!value) return;
    unsubscribe();
    if (!hasRole(value, "admin")) {
      window.location.href = "/";
      return;
    }
    loadJobs();
  });

  render();
</script>
