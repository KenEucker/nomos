---
import ResourcePanelPage from "../../components/ResourcePanelPage.astro";
import { createResourcePanel, type ResourcePanelConfig } from "../../lib/resource-panel";
import { sessionsResource } from "./sessions.resource";
const resourceConfig: ResourcePanelConfig = {
  resource: sessionsResource,
  mode: "list",
};
const panel = createResourcePanel(resourceConfig);
---
<ResourcePanelPage {panel} resourceConfig={resourceConfig} />
