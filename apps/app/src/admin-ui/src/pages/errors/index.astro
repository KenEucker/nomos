---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "errors",
  title: "Errors",
  subtitle: "Review recent error reports and stack traces.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <div id="errors-root" class="space-y-4"></div>
</AdminLayout>

<script type="module">
  import { apiGet } from "../../lib/api";
  import { session, hasRole } from "../../lib/session";

  const root = document.getElementById("errors-root");
  const state = { loading: true, errors: [], typeFilter: "", expandedRow: null };

  const formatDate = (date) =>
    new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "medium" }).format(new Date(date));

  const getErrorType = (entry) => {
    if (entry.type) return entry.type;
    if (entry.error.includes("TypeError")) return "TypeError";
    if (entry.error.includes("ReferenceError")) return "ReferenceError";
    if (entry.error.includes("SyntaxError")) return "SyntaxError";
    return "Error";
  };

  const render = () => {
    if (!root) return;
    const uniqueTypes = [...new Set(state.errors.map((entry) => getErrorType(entry)))].sort();
    const filtered = state.errors
      .filter((entry) => (!state.typeFilter ? true : getErrorType(entry) === state.typeFilter))
      .reverse();

    if (state.loading) {
      root.innerHTML = '<div class="text-slate-400">Loading errors...</div>';
      return;
    }

    root.innerHTML = `
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <select id="errors-filter" class="px-3 py-2 text-sm border rounded bg-slate-900 border-slate-700 text-slate-100">
          <option value="">All types</option>
          ${uniqueTypes.map((type) => `<option value="${type}" ${type === state.typeFilter ? "selected" : ""}>${type}</option>`).join("")}
        </select>
        <button id="errors-refresh" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Refresh</button>
      </div>

      ${filtered.length === 0
        ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No errors found. That\\'s good!</div>'
        : `
          <div class="mb-2 text-xs text-slate-500">Showing ${filtered.length} errors</div>
          <table class="w-full">
            <thead class="text-xs text-left uppercase text-slate-400">
              <tr>
                <th class="pb-2">Timestamp</th>
                <th class="pb-2">Type</th>
                <th class="pb-2">Message</th>
                <th class="pb-2">Source</th>
                <th class="pb-2"></th>
              </tr>
            </thead>
            <tbody class="text-sm">
              ${filtered.map((entry, index) => `
                <tr class="border-t border-slate-800">
                  <td class="py-3 text-xs text-slate-400 whitespace-nowrap">${formatDate(entry.timestamp)}</td>
                  <td class="py-3"><span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${getErrorType(entry)}</span></td>
                  <td class="max-w-md py-3 text-red-400 truncate">${entry.error}</td>
                  <td class="py-3 font-mono text-xs text-slate-400">${entry.source ?? entry.routeId ?? "-"}</td>
                  <td class="py-3">
                    ${entry.stack ? `<button data-index="${index}" class="text-xs text-slate-300 hover:text-slate-100">${state.expandedRow === index ? "Hide" : "Stack"}</button>` : ""}
                  </td>
                </tr>
                ${state.expandedRow === index && entry.stack
                  ? `
                    <tr class="border-t border-slate-800 bg-slate-900/50">
                      <td colspan="5" class="px-4 py-3">
                        <pre class="overflow-auto text-xs whitespace-pre-wrap text-slate-400 max-h-64">${entry.stack}</pre>
                      </td>
                    </tr>
                  `
                  : ""
                }
              `).join("")}
            </tbody>
          </table>
        `
      }
    `;

    document.getElementById("errors-filter")?.addEventListener("change", (event) => {
      state.typeFilter = event.target.value;
      render();
    });
    document.getElementById("errors-refresh")?.addEventListener("click", loadErrors);
    root.querySelectorAll("button[data-index]").forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(button.getAttribute("data-index"));
        state.expandedRow = state.expandedRow === index ? null : index;
        render();
      });
    });
  };

  const loadErrors = async () => {
    state.loading = true;
    render();
    try {
      const response = await apiGet("/_/errors");
      state.errors = response.data?.errors ?? [];
    } catch (e) {
      console.error("Failed to load errors", e);
      state.errors = [];
    }
    state.loading = false;
    render();
  };

  const unsubscribe = session.subscribe((value) => {
    if (!value) return;
    unsubscribe();
    if (!hasRole(value, "admin")) {
      window.location.href = "/";
      return;
    }
    loadErrors();
  });

  render();
</script>
