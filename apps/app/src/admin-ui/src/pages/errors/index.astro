---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ResourceView from "../../islands/ResourceView.svelte";
import { createStaticListModule } from "../../lib/pages";
import { errorsResource } from "./errors.resource";

export const pageModule = createStaticListModule({
  resourceId: "errors",
  title: "Errors",
  subtitle: "Review recent error reports and stack traces.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <ResourceView client:load definition={errorsResource} view="List" />
</AdminLayout>
