---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Table from "../../components/ui/table.svelte";
import Badge from "../../components/ui/badge.svelte";
import Input from "../../components/ui/input.svelte";
import Button from "../../components/ui/button.svelte";
import { usersResource } from "../../lib/resources/definitions/users";
import { serverApiGet, ServerApiError } from "../../lib/server/api";

const search = Astro.url.searchParams.get("search") ?? "";
const page = Astro.url.searchParams.get("page") ?? "1";
const pageSize = usersResource.list.pageSize ?? 20;

const params = new URLSearchParams({
  page,
  pageSize: String(pageSize)
});
if (search) {
  params.set("search", search);
}
if (usersResource.list.defaultSort) {
  params.set("sort", `${usersResource.list.defaultSort.key}:${usersResource.list.defaultSort.dir}`);
}

let users: Array<{ id: string; name: string; email: string; roles: string[]; createdAt?: string }> = [];
let total = 0;
let errorMessage: string | null = null;

try {
  const listUrl = `${usersResource.endpoints.list}?${params.toString()}`;
  const response = await serverApiGet<{ users: typeof users }>(Astro.request, listUrl);
  const dataKey = usersResource.dataKey ?? usersResource.id;
  users = response.data?.[dataKey] ?? [];
  total = response.meta?.total ?? users.length;
} catch (error) {
  if (error instanceof ServerApiError && error.status === 401) {
    return Astro.redirect("/admin/login");
  }
  errorMessage = error instanceof Error ? error.message : "Failed to load users.";
}

const formatDateTime = (value?: string) => {
  if (!value) return "-";
  try {
    return new Date(value).toLocaleString();
  } catch {
    return value;
  }
};
---
<BaseLayout title="Users">
  <div class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-2xl font-semibold">Users</h1>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            {total} total
          </p>
        </div>
        <a
          href="/admin/users/new"
          class="inline-flex h-9 items-center justify-center rounded-md bg-slate-900 px-4 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200"
        >
          New user
        </a>
      </div>

      <form method="get" class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="flex flex-1 gap-2">
          <Input
            className="flex-1 sm:max-w-sm"
            name="search"
            value={search}
            placeholder={usersResource.list.searchPlaceholder ?? "Search users"}
          />
          <Button type="submit" variant="secondary">Search</Button>
        </div>
      </form>

      {errorMessage ? (
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950/40 dark:text-red-200">
          {errorMessage}
        </div>
      ) : users.length === 0 ? (
        <div class="rounded-lg border border-slate-200 bg-white/40 px-4 py-10 text-center text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-900/40 dark:text-slate-400">
          No users found.
        </div>
      ) : (
        <div class="rounded-lg border border-slate-200 bg-white/40 dark:border-slate-800 dark:bg-slate-900/40">
          <Table>
            <thead class="text-xs uppercase text-slate-500 dark:text-slate-400">
              <tr>
                <th class="px-4 py-3 text-left">Name</th>
                <th class="px-4 py-3 text-left">Email</th>
                <th class="px-4 py-3 text-left">Roles</th>
                <th class="px-4 py-3 text-left">Created</th>
                <th class="px-4 py-3 text-left">Actions</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              {users.map((user) => (
                <tr class="border-t border-slate-200 hover:bg-slate-100/50 dark:border-slate-800 dark:hover:bg-slate-800/30">
                  <td class="px-4 py-3 font-medium text-slate-900 dark:text-slate-100">{user.name}</td>
                  <td class="px-4 py-3 text-slate-500 dark:text-slate-400">{user.email}</td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-2">
                      {(user.roles ?? []).map((role) => (
                        <Badge variant={role === "admin" ? "success" : "secondary"}>{role}</Badge>
                      ))}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-500 dark:text-slate-400">
                    {formatDateTime(user.createdAt)}
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-2">
                      <a
                        href={`/admin/users/${user.id}`}
                        class="text-sm font-medium text-slate-900 hover:underline dark:text-slate-100"
                      >
                        View
                      </a>
                      <a
                        href={`/admin/users/${user.id}/edit`}
                        class="text-sm font-medium text-slate-500 hover:underline dark:text-slate-400"
                      >
                        Edit
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
