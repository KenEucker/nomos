---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createStaticListModule } from "../../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "webhooks",
  title: "Webhooks",
  subtitle: "Inspect destinations and recent deliveries.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <div id="webhooks-root" class="space-y-4"></div>
</AdminLayout>

<script type="module">
  import { apiGet, apiPost } from "../../lib/api";
  import { session, hasRole } from "../../lib/session";

  const root = document.getElementById("webhooks-root");
  const state = {
    loading: true,
    destinations: [],
    deliveries: [],
    activeTab: "destinations",
    showCreate: false,
    newUrl: "",
    newEvents: [],
    newSecret: "",
    newRetryAttempts: "3",
    newRetryDelay: "1000",
  };

  const formatDate = (date) => {
    if (!date) return "-";
    return new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(date));
  };

  const render = () => {
    if (!root) return;
    if (state.loading) {
      root.innerHTML = '<div class="text-slate-400">Loading webhooks...</div>';
      return;
    }

    const destinationsTable = state.destinations.length === 0
      ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No webhook destinations configured.</div>'
      : `
        <table class="w-full">
          <thead class="text-xs text-left uppercase text-slate-400">
            <tr>
              <th class="pb-2">URL</th>
              <th class="pb-2">Events</th>
              <th class="pb-2">Secret</th>
              <th class="pb-2">Retry Policy</th>
              <th class="pb-2">Created</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            ${state.destinations.map((dest) => `
              <tr class="border-t border-slate-800">
                <td class="py-3">
                  <div class="max-w-xs font-mono text-sm truncate text-slate-100">${dest.url}</div>
                  <div class="text-xs text-slate-500">${dest.id.slice(0, 8)}...</div>
                </td>
                <td class="py-3">
                  <div class="flex flex-wrap gap-1">
                    ${dest.events.slice(0, 2).map((event) => `<span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${event}</span>`).join("")}
                    ${dest.events.length > 2 ? `<span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">+${dest.events.length - 2}</span>` : ""}
                  </div>
                </td>
                <td class="py-3 text-slate-400">${dest.secret ? "********" : "-"}</td>
                <td class="py-3 text-xs text-slate-400">${dest.retryPolicy?.attempts ?? 3} attempts</td>
                <td class="py-3 text-xs text-slate-400">${formatDate(dest.createdAt)}</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      `;

    const deliveriesTable = state.deliveries.length === 0
      ? '<div class="rounded-lg border border-slate-800 bg-slate-900/40 py-8 text-center text-slate-400">No webhook deliveries yet.</div>'
      : `
        <table class="w-full">
          <thead class="text-xs text-left uppercase text-slate-400">
            <tr>
              <th class="pb-2">Event</th>
              <th class="pb-2">Destination</th>
              <th class="pb-2">Status</th>
              <th class="pb-2">Attempts</th>
              <th class="pb-2">Last Attempt</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            ${state.deliveries.slice(-50).reverse().map((delivery) => `
              <tr class="border-t border-slate-800">
                <td class="py-3"><span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${delivery.event}</span></td>
                <td class="py-3 font-mono text-xs text-slate-400">${delivery.destinationId.slice(0, 8)}...</td>
                <td class="py-3"><span class="rounded-full bg-slate-700 px-2 py-1 text-xs text-slate-200">${delivery.status}</span></td>
                <td class="py-3 text-slate-400">${delivery.attempts}</td>
                <td class="py-3 text-xs text-slate-400">${formatDate(delivery.lastAttemptAt)}</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      `;

    root.innerHTML = `
      <div class="flex items-center justify-between mb-4">
        <div class="flex gap-2">
          <button data-tab="destinations" class="rounded px-3 py-2 text-sm ${state.activeTab === "destinations" ? "bg-slate-200 text-slate-900" : "border border-slate-700 text-slate-200"}">Destinations</button>
          <button data-tab="deliveries" class="rounded px-3 py-2 text-sm ${state.activeTab === "deliveries" ? "bg-slate-200 text-slate-900" : "border border-slate-700 text-slate-200"}">Delivery Log</button>
        </div>
        <button id="webhooks-add" class="rounded bg-slate-200 px-3 py-2 text-sm text-slate-900">Add Webhook</button>
      </div>
      ${state.activeTab === "destinations" ? destinationsTable : deliveriesTable}
      ${state.showCreate ? `
        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
          <h2 class="text-lg font-semibold">Add Webhook Destination</h2>
          <div class="space-y-3 mt-4">
            <div>
              <label class="block mb-1 text-sm text-slate-400">URL *</label>
              <input id="webhooks-url" class="w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value="${state.newUrl}" placeholder="https://example.com/webhook" />
            </div>
            <div>
              <label class="block mb-1 text-sm text-slate-400">Events (comma-separated)</label>
              <input id="webhooks-events" class="w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value="${state.newEvents.join(",")}" placeholder="user.created, user.deleted" />
            </div>
            <div>
              <label class="block mb-1 text-sm text-slate-400">Secret (for HMAC signing)</label>
              <input id="webhooks-secret" class="w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value="${state.newSecret}" placeholder="Optional secret" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block mb-1 text-sm text-slate-400">Retry Attempts</label>
                <input id="webhooks-attempts" class="w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value="${state.newRetryAttempts}" />
              </div>
              <div>
                <label class="block mb-1 text-sm text-slate-400">Retry Delay (ms)</label>
                <input id="webhooks-delay" class="w-full rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100" value="${state.newRetryDelay}" />
              </div>
            </div>
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <button id="webhooks-cancel" class="rounded border border-slate-700 px-3 py-2 text-sm text-slate-100">Cancel</button>
            <button id="webhooks-create" class="rounded bg-slate-200 px-3 py-2 text-sm text-slate-900">Add Webhook</button>
          </div>
        </div>
      ` : ""}
    `;

    root.querySelectorAll("[data-tab]").forEach((button) => {
      button.addEventListener("click", () => {
        state.activeTab = button.getAttribute("data-tab");
        render();
      });
    });
    document.getElementById("webhooks-add")?.addEventListener("click", () => {
      state.showCreate = true;
      render();
    });
    document.getElementById("webhooks-cancel")?.addEventListener("click", () => {
      state.showCreate = false;
      render();
    });
    document.getElementById("webhooks-create")?.addEventListener("click", createWebhook);
    document.getElementById("webhooks-url")?.addEventListener("input", (event) => {
      state.newUrl = event.target.value;
    });
    document.getElementById("webhooks-events")?.addEventListener("input", (event) => {
      state.newEvents = event.target.value.split(",").map((value) => value.trim()).filter(Boolean);
    });
    document.getElementById("webhooks-secret")?.addEventListener("input", (event) => {
      state.newSecret = event.target.value;
    });
    document.getElementById("webhooks-attempts")?.addEventListener("input", (event) => {
      state.newRetryAttempts = event.target.value;
    });
    document.getElementById("webhooks-delay")?.addEventListener("input", (event) => {
      state.newRetryDelay = event.target.value;
    });
  };

  const loadWebhooks = async () => {
    state.loading = true;
    render();
    try {
      const response = await apiGet("/_/webhooks");
      state.destinations = response.data?.destinations ?? [];
      state.deliveries = response.data?.deliveries ?? [];
    } catch (e) {
      console.error("Failed to load webhooks", e);
      state.destinations = [];
      state.deliveries = [];
    }
    state.loading = false;
    render();
  };

  const createWebhook = async () => {
    try {
      const body = {
        url: state.newUrl,
        events: state.newEvents,
        secret: state.newSecret || undefined,
        retryPolicy: {
          attempts: parseInt(state.newRetryAttempts) || 3,
          delayMs: parseInt(state.newRetryDelay) || 1000,
        },
      };
      await apiPost("/_/webhooks", body);
      state.showCreate = false;
      state.newUrl = "";
      state.newEvents = [];
      state.newSecret = "";
      state.newRetryAttempts = "3";
      state.newRetryDelay = "1000";
      await loadWebhooks();
    } catch (e) {
      console.error("Failed to create webhook", e);
    }
  };

  const unsubscribe = session.subscribe((value) => {
    if (!value) return;
    unsubscribe();
    if (!hasRole(value, "admin")) {
      window.location.href = "/";
      return;
    }
    loadWebhooks();
  });

  render();
</script>
