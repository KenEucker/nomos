---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ResourceView from "../../islands/ResourceView.svelte";
import { createStaticListModule } from "../../lib/pages";
import { webhooksResource } from "./webhooks.resource";

export const staticPageDefinition = createStaticListModule({
  resourceId: "webhooks",
  title: "Webhooks",
  subtitle: "Inspect destinations and recent deliveries.",
});
---
<AdminLayout title={staticPageDefinition.title} subtitle={staticPageDefinition.subtitle} breadcrumbs={staticPageDefinition.breadcrumbs} actions={staticPageDefinition.pageActions}>
  <ResourceView client:load definition={webhooksResource} view="List" />
</AdminLayout>
