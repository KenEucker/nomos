---
import AdminLayout from "../layouts/AdminLayout.astro";
import DashboardView from "./DashboardView.svelte";
import { createStaticListModule } from "../lib/pages";

export const pageModule = createStaticListModule({
  resourceId: "dashboard",
  title: "Dashboard",
  subtitle: "Overview of system activity.",
});
---
<AdminLayout title={pageModule.title} subtitle={pageModule.subtitle} breadcrumbs={pageModule.breadcrumbs} actions={pageModule.pageActions}>
  <DashboardView client:load />
</AdminLayout>
