---
import BaseLayout from "./BaseLayout.astro";
import Toast from "../components/ui/toast.svelte";
import NomosNav from "../components/NomosNav.svelte";
import ShellState from "../islands/ShellState.svelte";
import SessionLoader from "../islands/SessionLoader.svelte";
import type { SessionUser } from "../lib/session";
import { requireAdminSession } from "../lib/server/session";
import { buildAdminNav } from "../lib/navigation";

type PageBreadcrumb = {
  label: string;
  href?: string;
};

type PageAction = {
  label: string;
  href: string;
  variant?: "secondary" | "outline" | "ghost" | "destructive";
};

type Props = {
  title?: string;
  subtitle?: string;
  breadcrumbs?: PageBreadcrumb[];
  actions?: PageAction[];
};

const {
  title = "Dashboard",
  subtitle,
  breadcrumbs = [],
  actions = []
}: Props = Astro.props;

const sessionResult = await requireAdminSession(Astro);
if (sessionResult instanceof Response) {
  return sessionResult;
}
const user = sessionResult as SessionUser;
const navItems = buildAdminNav({ basePath: import.meta.env.BASE_URL });

const actionClass = (variant?: string) => {
  switch (variant) {
    case "secondary":
      return "bg-secondary text-secondary-foreground hover:bg-secondary/80";
    case "outline":
      return "border border-border text-foreground hover:bg-accent hover:text-accent-foreground";
    case "ghost":
      return "text-foreground hover:bg-accent hover:text-accent-foreground";
    case "destructive":
      return "bg-destructive text-white hover:bg-destructive/90";
    default:
      return "bg-primary text-primary-foreground hover:bg-primary/90";
  }
};
---
<BaseLayout title={title}>
  <ShellState client:load />
  <SessionLoader client:load />
  <div class="min-h-screen bg-background text-foreground" style="--nomos-header-height: 0px;">
    <div class="admin-shell">
      <div class="admin-shell-nav">
        <NomosNav menuName="Ken's Admin" client:load {navItems} />
      </div>

      <main id="swup" class="overflow-x-hidden admin-shell-main">
        <div class="p-4 sm:p-6 md:p-8">
          <div class="mb-6 space-y-2">
            {breadcrumbs.length > 0 ? (
              <nav class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                {breadcrumbs.map((crumb, index) => (
                  <>
                    {crumb.href ? (
                      <a class="hover:text-foreground" href={crumb.href}>
                        {crumb.label}
                      </a>
                    ) : (
                      <span>{crumb.label}</span>
                    )}
                    {index < breadcrumbs.length - 1 ? (
                      <span class="text-border">/</span>
                    ) : null}
                  </>
                ))}
              </nav>
            ) : null}
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              {actions.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {actions.map((action) => (
                    <a
                      href={action.href}
                      class={`inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 ring-offset-background h-9 px-4 py-2 ${actionClass(
                        action.variant
                      )}`}
                    >
                      {action.label}
                    </a>
                  ))}
                </div>
              ) : null}
            </div>
          </div>

          <div class="min-w-0">
            <slot />
          </div>
        </div>
      </main>
    </div>
    <Toast client:load />
  </div>
</BaseLayout>
