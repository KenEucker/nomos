---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ui/theme-toggle.svelte";
import Toast from "../components/ui/toast.svelte";
import ShellState from "../islands/ShellState.svelte";
import SessionLoader from "../islands/SessionLoader.svelte";
import NavHighlight from "../islands/NavHighlight.svelte";
import LogoutButton from "../components/LogoutButton.svelte";
import type { PageAction, PageBreadcrumb } from "../lib/pages/types";
import type { SessionUser } from "../lib/session";
import { requireAdminSession } from "../lib/server/session";
import { buildAdminNav } from "../lib/navigation";

type Props = {
  title?: string;
  subtitle?: string;
  breadcrumbs?: PageBreadcrumb[];
  actions?: PageAction[];
};

const {
  title = "Dashboard",
  subtitle,
  breadcrumbs = [],
  actions = []
}: Props = Astro.props;

const sessionResult = await requireAdminSession(Astro);
if (sessionResult instanceof Response) {
  return sessionResult;
}
const user = sessionResult as SessionUser;

const activePath = Astro.url.pathname;

const navItems = buildAdminNav({ basePath: import.meta.env.BASE_URL });
const groupedNav = navItems.reduce(
  (acc, item) => {
    if (item.group) {
      const groupItems = acc.groups.get(item.group) ?? [];
      groupItems.push(item);
      acc.groups.set(item.group, groupItems);
    } else {
      acc.ungrouped.push(item);
    }
    return acc;
  },
  { ungrouped: [] as typeof navItems, groups: new Map<string, typeof navItems>() }
);
const navGroups = Array.from(groupedNav.groups.entries()).map(([label, items]) => ({
  label,
  items
}));

const logoutIcon =
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>';

const hasRole = (role?: string) => !role || user?.roles?.includes(role);
const isActive = (path: string) =>
  path === "/admin" ? activePath === "/admin" : activePath === path || activePath.startsWith(`${path}/`);

const actionClass = (variant?: string) => {
  switch (variant) {
    case "secondary":
      return "bg-slate-200 text-slate-900 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700";
    case "outline":
      return "border border-slate-300 text-slate-900 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-100 dark:hover:bg-slate-900";
    case "ghost":
      return "text-slate-900 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-800";
    case "destructive":
      return "bg-red-500 text-white hover:bg-red-600";
    default:
      return "bg-slate-900 text-slate-100 hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200";
  }
};
---
<BaseLayout title={title}>
  <ShellState client:load />
  <SessionLoader client:load />
  <NavHighlight client:load />
  <div class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <header class="sticky top-0 z-40 border-b admin-mobile-header border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95 md:hidden">
      <div class="flex items-center h-12 gap-2 px-3">
        <span class="text-lg font-semibold">Nomos</span>
        <div class="flex-1"></div>
        <ThemeToggle client:load collapsed={true} />
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-md p-1.5 text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
          data-shell-toggle="mobile"
          aria-label="Toggle menu"
          title="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <LogoutButton
          client:load
          showLabel={false}
          label="Log out"
          icon={logoutIcon}
          className="p-1 inline-flex items-center justify-center rounded-md text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
        />
      </div>

      <nav class="flex overflow-x-auto border-t admin-mobile-nav scrollbar-hide border-slate-200/50 dark:border-slate-800/50">
        <div class="flex gap-1 px-2 py-2 admin-mobile-nav-items">
          {navItems.map((item) =>
            hasRole(item.role) ? (
              <a
                href={item.path}
                data-nav-path={item.path}
                data-active={isActive(item.path) ? "true" : "false"}
                class="flex items-center flex-shrink-0 gap-2 text-sm font-medium transition rounded-md admin-mobile-nav-link whitespace-nowrap"
              >
                <Fragment set:html={item.icon ?? ""} />
                <span class="mobile-nav-label">{item.label}</span>
              </a>
            ) : null
          )}
        </div>
      </nav>
      <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
        <ThemeToggle client:load collapsed={false} />
      </div>
    </header>

    <div class="flex min-h-screen">
      <aside class="hidden transition-all duration-200 border-r admin-sidebar border-slate-200 bg-slate-50/40 dark:border-slate-800 dark:bg-slate-900/40 md:block">
        <div class="sticky top-0 flex flex-col h-full">
          <div class="flex items-center px-4 border-b admin-sidebar-logo h-14 border-slate-200 dark:border-slate-800">
            <span class="text-xl font-bold admin-logo-short text-slate-900 dark:text-slate-100">N</span>
            <span class="text-lg font-semibold admin-logo-full">Nomos Admin</span>
          </div>

          <div class="px-4 py-3 border-b admin-user-block border-slate-200 dark:border-slate-800">
            <div class="text-sm truncate text-slate-500 dark:text-slate-400">{user?.email}</div>
          </div>

          <nav class="flex-1 p-2 space-y-3">
            <div class="space-y-1">
              {groupedNav.ungrouped.map((item) =>
                hasRole(item.role) ? (
                  <a
                    href={item.path}
                    data-nav-path={item.path}
                    data-active={isActive(item.path) ? "true" : "false"}
                    class="flex items-center text-sm font-medium transition rounded-md admin-nav-item group"
                  >
                    <Fragment set:html={item.icon ?? ""} />
                    <span class="admin-nav-label">{item.label}</span>
                  </a>
                ) : null
              )}
            </div>
            {navGroups.map((group) => (
              <details class="space-y-2" open={group.items.some((item) => isActive(item.path))}>
                <summary class="px-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 cursor-pointer select-none">
                  {group.label}
                </summary>
                <div class="space-y-1 pl-2">
                  {group.items.map((item) =>
                    hasRole(item.role) ? (
                      <a
                        href={item.path}
                        data-nav-path={item.path}
                        data-active={isActive(item.path) ? "true" : "false"}
                        class="flex items-center text-sm font-medium transition rounded-md admin-nav-item group"
                      >
                        <Fragment set:html={item.icon ?? ""} />
                        <span class="admin-nav-label">{item.label}</span>
                      </a>
                    ) : null
                  )}
                </div>
              </details>
            ))}
          </nav>

          <div class="p-2 border-t border-slate-200 dark:border-slate-800">
            <ThemeToggle client:load collapsed={false} />
            <button
              type="button"
              data-shell-toggle="sidebar"
              class="flex items-center w-full text-sm font-medium transition rounded-md admin-sidebar-toggle text-slate-600 hover:bg-slate-200 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
              title="Toggle sidebar"
            >
              <svg class="flex-shrink-0 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
              </svg>
              <span class="admin-collapse-label">Collapse</span>
            </button>
            <LogoutButton
              client:load
              label="Log out"
              icon={logoutIcon}
              className="admin-sidebar-toggle flex w-full items-center rounded-md text-sm font-medium text-slate-600 transition hover:bg-slate-200 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            />
          </div>
        </div>
      </aside>

      <main id="swup" class="flex-1 overflow-x-hidden admin-main">
        <div class="p-4 sm:p-6 md:p-8">
          <div class="mb-6 space-y-2">
            {breadcrumbs.length > 0 ? (
              <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                {breadcrumbs.map((crumb, index) => (
                  <>
                    {crumb.href ? (
                      <a class="hover:text-slate-900 dark:hover:text-slate-100" href={crumb.href}>
                        {crumb.label}
                      </a>
                    ) : (
                      <span>{crumb.label}</span>
                    )}
                    {index < breadcrumbs.length - 1 ? (
                      <span class="text-slate-300 dark:text-slate-700">/</span>
                    ) : null}
                  </>
                ))}
              </nav>
            ) : null}
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h1 class="text-xl font-semibold sm:text-2xl">{title}</h1>
                {subtitle ? (
                  <p class="text-sm text-slate-500 dark:text-slate-400">{subtitle}</p>
                ) : (
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    Signed in as {user?.name}
                  </p>
                )}
              </div>
              {actions.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {actions.map((action) => (
                    <a
                      href={action.href}
                      class={`inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 ring-offset-white dark:ring-offset-slate-950 h-9 px-4 py-2 ${actionClass(
                        action.variant
                      )}`}
                    >
                      {action.label}
                    </a>
                  ))}
                </div>
              ) : null}
            </div>
          </div>

          <div class="min-w-0">
            <slot />
          </div>
        </div>
      </main>
    </div>
    <Toast client:load />
  </div>
</BaseLayout>
