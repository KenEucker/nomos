---
import "../styles/global.css";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en" class="bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="turbo-cache-control" content="no-cache" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script type="module">import "@hotwired/turbo";</script>
    <script is:inline>
      (function() {
        if (window.__turboFadeInit) return;
        window.__turboFadeInit = true;
        const root = document.documentElement;
        const start = () => root.classList.add("is-navigating");
        const end = () => root.classList.remove("is-navigating");
        document.addEventListener("turbo:visit", start);
        document.addEventListener("turbo:load", end);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <slot />
  </body>
</html>
