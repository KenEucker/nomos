---
import "../styles/global.css";
import AppShell from "../islands/AppShell.svelte";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en" class="bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <style is:inline>
      html { background: #f1f5f9; }
      html.dark { background: #020617; }
      :root { color-scheme: light dark; }
    </style>
    <script is:inline>
      (function() {
        if (window.__nomosSwupHooksRegistered) return;
        const register = () => {
          if (window.__nomosSwupHooksRegistered || !window.swup) return;
          window.__nomosSwupHooksRegistered = true;

          const notifyPageView = () => {
            window.dispatchEvent(
              new CustomEvent("nomos:page-view", { detail: { path: window.location.pathname } })
            );
          };

          window.swup.hooks.on("page:view", notifyPageView);
          window.swup.hooks.on("page:view", () => {
            console.log("[swup] page:view", window.location.pathname);
          });
          window.swup.hooks.on("animation:out:start", () => {
            console.log("[swup] animation out");
          });
          notifyPageView();
        };

        if (window.swup) {
          register();
        } else {
          document.addEventListener("swup:enable", register, { once: true });
        }
      })();
    </script>

  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <!-- Swup swaps the #swup container; hooks dispatch nomos:page-view for persistent UI. -->
    <AppShell client:load {title}>
      <main id="swup" class="transition-main">
        <slot />
      </main>
    </AppShell>
  </body>
</html>
