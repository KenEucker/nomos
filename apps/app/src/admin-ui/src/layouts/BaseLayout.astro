---
import "../styles/global.css";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        const stored = localStorage.getItem("nomos.theme.v1");
        if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground mobile-menu-collapsed">
    <slot />
  </body>
</html>
