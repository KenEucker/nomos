---
import "../styles/global.css";
import AppShell from "../islands/AppShell.svelte";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en" class="bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <style is:inline>
      html { background: #f1f5f9; }
      html.dark { background: #020617; }
      :root { color-scheme: light dark; }
    </style>
    <script is:inline>
      (function() {
        const isModifiedEvent = (event) =>
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0;

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest("a[href]");
          if (!link) return;
          if (link.hasAttribute("download")) return;
          if (link.getAttribute("target")) return;
          if (isModifiedEvent(event)) return;

          const href = link.getAttribute("href") || "";
          if (!href || href.startsWith("#")) return;

          const url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (!url.pathname.startsWith("/admin")) return;

          if (window.swup) {
            event.preventDefault();
            window.swup.navigate(url.pathname + url.search + url.hash);
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <!-- Swup swaps the #swup container; the shell stays mounted. -->
    <AppShell client:load {title}>
      <main id="swup" class="transition-main">
        <slot />
      </main>
    </AppShell>
  </body>
</html>
