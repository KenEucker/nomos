---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ViewTransitions />

    <script is:inline>
      // Function to apply theme and preferences
      function applyThemeAndPrefs() {
        var root = document.documentElement;

        // Apply theme
        var themeStored = localStorage.getItem("nomos.theme.v1");
        var isDark = themeStored === "dark" || (!themeStored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", isDark);

        // Apply nav preferences data attributes
        var navStored = localStorage.getItem("nomos.nav.preferences.v1");
        var navPrefs = navStored ? JSON.parse(navStored) : {};
        root.dataset.navDesktopDock = navPrefs.desktopDock || "left";
        root.dataset.navMobileDock = navPrefs.mobileDock || "top";
        root.dataset.navCollapsed = navPrefs.sidebarCollapsed ? "true" : "false";
        root.dataset.navDense = navPrefs.denseMode ? "true" : "false";
        root.dataset.navShowGroups = navPrefs.showGroupHeadings !== false ? "true" : "false";
        root.dataset.navTooltips = navPrefs.enableTooltips !== false ? "true" : "false";
        root.dataset.navReduceMotion = navPrefs.reduceMotion ? "true" : "false";
        root.dataset.navMode = "nav";
      }

      // Apply immediately on page load
      applyThemeAndPrefs();

      // Re-apply after View Transitions navigation
      document.addEventListener("astro:page-load", applyThemeAndPrefs);
      document.addEventListener("astro:after-swap", applyThemeAndPrefs);

      // Loading bar and immediate outgoing animation
      document.addEventListener("astro:before-preparation", function() {
        // Show loading bar
        var loadingBar = document.getElementById("nav-loading-bar");
        if (loadingBar) {
          loadingBar.classList.add("loading");
        }
        // Start outgoing animation immediately
        var mainContent = document.getElementById("swup");
        if (mainContent) {
          mainContent.classList.add("navigating-out");
        }
      });

      document.addEventListener("astro:after-swap", function() {
        // Remove navigating class from new content
        var mainContent = document.getElementById("swup");
        if (mainContent) {
          mainContent.classList.remove("navigating-out");
        }
      });

      document.addEventListener("astro:page-load", function() {
        // Hide loading bar
        var loadingBar = document.getElementById("nav-loading-bar");
        if (loadingBar) {
          loadingBar.classList.remove("loading");
        }
      });
    </script>
    <style>
      .nav-loading-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: transparent;
        z-index: 9999;
        pointer-events: none;
      }
      .nav-loading-bar.loading {
        background: linear-gradient(90deg, transparent, var(--primary), transparent);
        animation: loading-slide 1s ease-in-out infinite;
      }
      @keyframes loading-slide {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
      }
      /* Disable loading bar animation when reduce motion is enabled */
      @media (prefers-reduced-motion: reduce) {
        .nav-loading-bar.loading {
          animation: none;
          background: var(--primary);
          opacity: 0.5;
        }
      }
      [data-nav-reduce-motion="true"] .nav-loading-bar.loading {
        animation: none;
        background: var(--primary);
        opacity: 0.5;
      }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground mobile-menu-collapsed">
    <!-- Loading indicator for page transitions -->
    <div id="nav-loading-bar" class="nav-loading-bar"></div>
    <slot />
  </body>
</html>
