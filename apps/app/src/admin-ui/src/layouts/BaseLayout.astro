---
import "../styles/global.css";
const { title = "Nomos Admin" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        var root = document.documentElement;

        // Initialize theme
        var themeStored = localStorage.getItem("nomos.theme.v1");
        if (themeStored === "dark" || (!themeStored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          root.classList.add("dark");
        }

        // Initialize nav preferences data attributes
        var navStored = localStorage.getItem("nomos.nav.preferences.v1");
        var navPrefs = navStored ? JSON.parse(navStored) : {};
        root.dataset.navDesktopDock = navPrefs.desktopDock || "left";
        root.dataset.navMobileDock = navPrefs.mobileDock || "top";
        root.dataset.navCollapsed = navPrefs.sidebarCollapsed ? "true" : "false";
        root.dataset.navDense = navPrefs.denseMode ? "true" : "false";
        root.dataset.navShowGroups = navPrefs.showGroupHeadings !== false ? "true" : "false";
        root.dataset.navTooltips = navPrefs.enableTooltips !== false ? "true" : "false";
        root.dataset.navReduceMotion = navPrefs.reduceMotion ? "true" : "false";
        root.dataset.navMode = "nav";
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground mobile-menu-collapsed">
    <slot />
  </body>
</html>
