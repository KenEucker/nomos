generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  sessions     Session[]
}

model Role {
  id    String     @id @default(cuid())
  key   String     @unique
  name  String
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PluginState {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  version         String
  description     String?
  source          String
  status          String
  enabled         Boolean  @default(false)
  lastError       String?
  discoveredAt    DateTime @default(now())
  installedAt     DateTime?
  enabledAt       DateTime?
  updatedAt       DateTime @updatedAt
  checksum        String?
  lastPreview     Json?
  lastPreviewedAt DateTime?
}
