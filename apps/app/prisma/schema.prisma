generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  todo
  doing
  done
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  sessions     Session[]
  createdProjects Project[] @relation("ProjectCreatedBy")
  assignedTasks   Task[]    @relation("TaskAssignedTo")
  comments     Comment[]
}

model Role {
  id    String     @id @default(cuid())
  key   String     @unique
  name  String
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  createdByUserId String
  createdByUser   User     @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  tasks           Task[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  description      String?
  status           TaskStatus @default(todo)
  assignedToUserId String?
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedToUser   User?      @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  comments         Comment[]
  attachments      Attachment[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Comment {
  id           String   @id @default(cuid())
  taskId       String
  body         String
  authorUserId String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUser   User     @relation(fields: [authorUserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attachment {
  id          String   @id @default(cuid())
  taskId      String
  key         String
  filename    String
  contentType String
  sizeBytes   Int
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}
