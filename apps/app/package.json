{
  "name": "nomos-platform",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:admin-ui && tsx src/server.ts",
    "build": "npm run build:admin-ui && tsc -p tsconfig.json",
    "build:admin-ui": "npm --prefix src/admin-ui install && npm --prefix src/admin-ui run build",
    "health-check": "node scripts/health-check.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^8.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.2",
    "@fastify/cookie": "^11.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "zod": "^4.3.5",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.11.19"
  }
}
