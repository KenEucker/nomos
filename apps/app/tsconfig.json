{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/platform/sdk/dist/**", "src/admin-ui/**"]
}
